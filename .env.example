# Kopioi tämä tiedosto nimelle .env ja täytä käyttämiesi kanavien arvot.
# Täytä vain niiden kanavien tiedot, jotka olet asettanut enabled: true
# -tilaan config.yaml:ssa - loput voi jättää tyhjäksi tai poistaa kokonaan.
#
# GitHub Actions -hostauksessa näitä ei tarvita tässä tiedostossa -
# ne lisätään sen sijaan repon Settings -> Secrets and variables ->
# Actions -> New repository secret -kohtaan, ks. docs/hosting-github-actions.md.

# Telegram-kanavalle (ks. https://t.me/BotFather uuden botin luontiin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sähköpostikanavalle
SMTP_USER=
SMTP_PASSWORD=
